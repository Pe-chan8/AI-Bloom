<turbo-stream action="replace" target="post_form_frame">
  <template>
    <div class="text-center py-6">
      <p class="text-lg font-semibold text-green-600">投稿が完了しました！</p>
    </div>
  </template>
</turbo-stream>

<turbo-stream action="append" target="ga-tracker">
  <template>
    <div data-controller="ga-event" data-ga-event-name-value="post_created"></div>
  </template>
</turbo-stream>

<turbo-stream action="append" target="post-modal-close-signal">
  <template>
    <span data-close-post-modal="1"></span>
  </template>
</turbo-stream>
