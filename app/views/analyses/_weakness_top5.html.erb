<% items = Array(local_assigns[:items]) %>
<% category = local_assigns[:category] || "all" %>
<% subcategory = local_assigns[:subcategory] %>
<% show_items = local_assigns[:show_weakness_items] %>

<div class="border border-slate-800 bg-white p-4 rounded-2xl shadow-sm h-full">
  <div class="flex items-center justify-between gap-3 mb-3">
    <p class="font-bold">苦手傾向</p>

    <% if show_items %>
      <%= link_to "▶︎ 閉じる",
            analysis_path(
              category: category,
              subcategory: subcategory,
              show_weakness_tips: (params[:show_weakness_tips].presence)
            ),
            class: "text-sm font-bold text-slate-700 hover:text-slate-900 underline" %>
    <% else %>
      <%= link_to "▶︎ 見る",
            analysis_path(
              category: category,
              subcategory: subcategory,
              show_weakness_items: "1",
              show_weakness_tips: (params[:show_weakness_tips].presence)
            ),
            class: "text-sm font-bold text-slate-700 hover:text-slate-900 underline" %>
    <% end %>
  </div>

  <% if show_items %>
    <p class="text-sm text-slate-600 mb-4">
      最近の会話から、少し疲れやすくなりやすいポイントをまとめました。
    </p>

    <% if items.empty? %>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-sm text-slate-700">
        まだデータがありません（会話や投稿が増えると表示されます）
      </div>
    <% else %>
      <ol class="space-y-3">
        <% items.each_with_index do |item, idx| %>
          <li class="bg-slate-50 border border-slate-200 rounded-xl p-3">
            <div class="flex items-start gap-2">
              <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-amber-100 text-slate-800 text-xs font-extrabold">
                <%= idx + 1 %>
              </span>
              <p class="font-bold text-slate-900">
                <%= item[:label] %>：<span class="font-semibold text-slate-700"><%= item[:short] %></span>
              </p>
            </div>
          </li>
        <% end %>
      </ol>
    <% end %>
  <% else %>
    <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-sm text-slate-700">
      <p class="font-bold">
         ＊しんどいときや、<br>
           無理を減らしたいときにだけ見てください
      </p>
      <p class="text-xs text-slate-500 mt-1">（必要なときだけ開けば大丈夫です）</p>
    </div>
  <% end %>
</div>
