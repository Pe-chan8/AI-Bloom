<nav
  class="border-t bg-white/95 backdrop-blur"
  style="position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;"
>
  <div class="mx-auto w-full max-w-screen-md px-3 pt-2 pb-[calc(env(safe-area-inset-bottom)+0.5rem)]">
    <ul
      class="grid gap-3 justify-items-center text-[11px] w-full"
      style="grid-template-columns: repeat(6, minmax(0, 1fr));"
    >
      <li>
        <%= link_to root_path, class: "flex flex-col items-center gap-1" do %>
          <%= image_tag "/bottom_nav/home.png", class: "w-8 h-8", alt: "マイルーム" %>
          <span class="font-semibold">マイルーム</span>
        <% end %>
      </li>

      <li>
        <%= link_to diagnosis_top_path, class: "flex flex-col items-center gap-1" do %>
          <%= image_tag "/bottom_nav/diagnosis.png", class: "w-8 h-8", alt: "診断" %>
          <span class="font-semibold">診断</span>
        <% end %>
      </li>

      <li>
        <%= link_to buddies_path, class: "flex flex-col items-center gap-1" do %>
          <%= image_tag "/bottom_nav/buddy.png", class: "w-8 h-8", alt: "バディ" %>
          <span class="font-semibold">バディ選択</span>
        <% end %>
      </li>

      <li>
        <%= link_to buddy_talk_path, class: "flex flex-col items-center gap-1" do %>
          <%= image_tag "/bottom_nav/buddy_talk.png", class: "w-8 h-8", alt: "バディと話す" %>
          <span class="font-semibold">バディと話す</span>
        <% end %>
      </li>

      <li>
        <%= link_to posts_path, class: "flex flex-col items-center gap-1" do %>
          <%= image_tag "/bottom_nav/post.png", class: "w-8 h-8", alt: "投稿一覧" %>
          <span class="font-semibold">投稿一覧</span>
        <% end %>
      </li>

      <li>
        <%= link_to "#", class: "flex flex-col items-center gap-1" do %>
          <%= image_tag "/bottom_nav/insight.png", class: "w-8 h-8", alt: "分析" %>
          <span class="font-semibold">分析</span>
          <span class="text-[10px] text-slate-500">準備中</span>
        <% end %>
      </li>
    </ul>
  </div>
</nav>
