<% content_for :title, "投稿一覧 - AI-bloom" %>

  <div class="flex justify-center">
    <div class="inline-flex items-center gap-2">
      <h1 class="text-3xl font-extrabold tracking-wide text-slate-900">
        投稿一覧
      </h1>
      <%= render "shared/help_tip",
        text: "これまでの記録をまとめて見られます。\n検索や編集もできます。",
        position: "right" %>
    </div>
  </div>

  <div class="max-w-3xl mx-auto pt-6 space-y-6 px-6 pb-10">
    <!-- 検索フォームカード -->
    <div class="bg-white rounded-2xl shadow-sm border border-amber-100 px-6 py-6 space-y-4">
      <div class="flex items-center gap-2 text-slate-600 text-sm">
        <span class="text-lg">🔍</span>
        <span>メモの内容からキーワードでさがす</span>
      </div>

      <%= search_form_for @q, url: posts_path, method: :get, local: true do |f| %>
        <div class="flex flex-col gap-3 sm:flex-row w-full">
          <div class="flex-1">
            <%= f.search_field :body_cont,
                  placeholder: "例）仕事 / 勉強 / うれしかったこと…",
                  class: "w-full border border-slate-200 rounded-xl px-4 py-2 text-sm
                          focus:ring-2 focus:ring-sky-300 focus:outline-none" %>
          </div>

          <div class="sm:w-auto">
            <%= f.submit "検索",
              class: "w-full sm:w-auto px-6 py-2 rounded-xl text-sm font-semibold
                      bg-sky-100 text-sky-700 border border-sky-200
                      hover:bg-sky-200 transition text-center" %>
          </div>
        </div>
      <% end %>

      <% if params[:q].present? %>
        <p class="text-xs text-slate-500">
          「<%= params.dig(:q, :body_cont) %>」で絞り込み中
          <%= link_to "検索条件をクリア", posts_path, class: "text-sky-600 underline" %>
        </p>
      <% end %>
    </div>

    <% if @posts.any? %>
      <div class="space-y-4">
        <% label_map = {"work"=>"仕事","love"=>"恋愛","family"=>"家庭","study"=>"学習","other"=>"その他"} %>

        <% @posts.each do |post| %>
          <div class="bg-white rounded-2xl shadow-sm border border-amber-100 px-5 py-4">
            <!-- 日時 -->
            <div class="flex items-center justify-between text-xs text-slate-500 mb-2">
              <span>
                <% datetime = post.posted_at || post.created_at %>
                <%= l datetime, format: :short %>
              </span>
            </div>

            <!-- タイトル -->
            <div class="text-base font-semibold text-slate-800">
              <%= post.title.presence || "（無題）" %>
            </div>

            <!-- 気分 + カテゴリ/サブカテゴリ + タグ -->
            <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
              <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-amber-50 text-amber-800 border border-amber-100 font-semibold">
                気分：<%= post.respond_to?(:mood_label) ? post.mood_label : (post.mood_i18n rescue post.mood) %>
              </span>

              <% if post.category.present? %>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-white text-slate-700 border border-slate-200 font-semibold">
                  <%= label_map[post.category] || post.category %>
                </span>
              <% end %>

              <% if post.subcategory.present? %>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-white text-slate-700 border border-slate-200 font-semibold">
                  <%= post.subcategory %>
                </span>
              <% end %>

              <% tags = post.tags_text.to_s.split(",").map(&:strip).reject(&:blank?) %>
              <% tags.each do |tag| %>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-slate-50 text-slate-700 border border-slate-200">
                  #<%= tag %>
                </span>
              <% end %>
            </div>

            <!-- アクション（入れ子防止：カード全体リンクはしない） -->
            <div class="mt-4 flex items-center justify-between gap-2">
              <%= link_to "会話を開く",
                    buddy_talk_topic_path(post),
                    data: { turbo: false },
                    class: "text-sm font-semibold text-amber-800 hover:underline" %>

              <div class="flex items-center gap-2">
                <%= link_to "編集",
                      edit_post_path(post),
                      data: { turbo_frame: "_top" },
                      class: "inline-flex items-center justify-center rounded-full px-4 py-2 text-xs font-semibold
                              border border-slate-200 bg-white text-slate-700 hover:bg-slate-50" %>

              <%= button_to "削除",
                    post_path(post),
                    method: :delete,
                    form: { data: { turbo_confirm: "本当にこの投稿を削除しますか？" } },
                    class: "text-xs px-4 py-2 rounded-full border border-rose-300 text-rose-600 hover:bg-rose-50" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if @posts.total_pages > 1 %>
        <div class="mt-6 flex justify-center">
          <div class="flex items-center gap-2">
            <% if @posts.prev_page %>
              <%= link_to "◀", url_for(page: @posts.prev_page),
                    class: "px-3 py-1.5 rounded-full bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 text-sm" %>
            <% else %>
              <span class="px-3 py-1.5 rounded-full bg-slate-100 text-slate-400 text-sm cursor-default">◀</span>
            <% end %>

            <% @posts.total_pages.times do |i| %>
              <% page_num = i + 1 %>
              <% if page_num == @posts.current_page %>
                <span class="px-3 py-1.5 rounded-full bg-amber-100 text-slate-800 border border-amber-200 text-sm font-semibold">
                  <%= page_num %>
                </span>
              <% else %>
                <%= link_to page_num, url_for(page: page_num),
                      class: "px-3 py-1.5 rounded-full bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 text-sm" %>
              <% end %>
            <% end %>

            <% if @posts.next_page %>
              <%= link_to "▶", url_for(page: @posts.next_page),
                    class: "px-3 py-1.5 rounded-full bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 text-sm" %>
            <% else %>
              <span class="px-3 py-1.5 rounded-full bg-slate-100 text-slate-400 text-sm cursor-default">▶</span>
            <% end %>
          </div>
        </div>
      <% end %>

    <% else %>
      <div class="bg-white rounded-2xl shadow-sm border border-amber-100 px-4 py-6 text-center text-sm text-slate-500">
        まだ投稿がありません。<br>
        <strong>「バディと話す」</strong>から、今日の気持ちを残してみましょう 🌻
      </div>
    <% end %>
  </div>
</div>