<turbo-stream action="append" target="flash">
  <template>
    <div class="border rounded-2xl px-4 py-3 text-sm bg-emerald-100 border-emerald-300 text-emerald-800 shadow-sm">
      投稿が完了しました！
    </div>
  </template>
</turbo-stream>

<turbo-stream action="append" target="ga-tracker">
  <template>
    <div data-controller="ga-event" data-ga-event-name-value="post_created"></div>
  </template>
</turbo-stream>

<turbo-stream action="append" target="post-modal-close-signal">
  <template>
    <span data-close-post-modal="1"></span>
    <script>
      setTimeout(() => {
        Turbo.visit("<%= post_path(@post) %>")
      }, 300)
    </script>
  </template>
</turbo-stream>
