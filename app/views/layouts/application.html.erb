<!DOCTYPE html>
<html data-env="<%= Rails.env %>">
  <head>
    <title><%= content_for(:title) || "AI-bloom" %></title>

    <%= display_meta_tags %>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- ===== Favicon ===== -->
    <%= favicon_link_tag "favicon/ai_bloom_favicon.ico" %>

    <% if Rails.env.production? && ENV["GA_MEASUREMENT_ID"].present? %>
      <script async src="https://www.googletagmanager.com/gtag/js?id=<%= ENV["GA_MEASUREMENT_ID"] %>"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag("js", new Date());
        gtag("config", "<%= ENV["GA_MEASUREMENT_ID"] %>");
      </script>
    <% end %>

    <%= yield :head %>

    <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      * { -webkit-tap-highlight-color: transparent !important; outline: none !important; }
      a, div, img, button { outline: none !important; }
    </style>
  </head>

  <body
    data-user-dominant-type="<%= user_signed_in? ? current_user.dominant_type : "" %>"
    class="min-h-screen flex flex-col bg-[#FFF6E5]"
    style="
      --bottom-nav-h: 72px;
      --composer-h: 0px;
      <%= yield(:body_style) if content_for?(:body_style) %>
    "
  >
    <header
      class="sticky top-0 bg-white/90 backdrop-blur shadow-sm"
      style="z-index: 10000;"
    >
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <%= link_to root_path, class: "inline-flex items-center" do %>
            <%= image_tag "ai_bloom_header.png", alt: "AI-bloom", class: "h-10 w-auto" %>
          <% end %>
        </div>

        <div class="flex items-center gap-3 text-xs text-slate-600">
          <% if user_signed_in? %>
            <span><%= current_user.nickname %></span>

            <%= button_to "ログアウト",
                  destroy_user_session_path,
                  method: :delete,
                  form: { data: { turbo: false } },
                  class: "hover:underline" %>

            <%= render "shared/nav/hamburger_menu" %>
          <% else %>
            <%= link_to "ログイン", new_user_session_path, class: "hover:underline" %>
            <%= link_to "新規登録",
                  new_user_registration_path,
                  class: "px-3 py-1 rounded-full bg-sky-500 text-white text-xs" %>
          <% end %>
        </div>
      </div>
    </header>

    <!-- flash -->
    <div id="flash" class="fixed top-16 left-1/2 -translate-x-1/2 z-[60] space-y-2 w-[min(520px,92vw)]">
      <% flash.each do |type, message| %>
        <% color =
          if type.to_s == "notice"
            "bg-emerald-100 border-emerald-300 text-emerald-800"
          else
            "bg-rose-100 border-rose-300 text-rose-800"
          end
        %>
        <div class="border rounded-2xl px-4 py-3 text-sm <%= color %> shadow-sm">
          <%= message %>
        </div>
      <% end %>
    </div>

    <main
      class="flex-1 pt-2 bg-[#FFF6E5]"
      style="padding-bottom: calc(var(--bottom-nav-h) + var(--composer-h) + 24px);"
    >
      <div class="max-w-5xl mx-auto px-4 py-8">
        <%= yield %>
      </div>
    </main>

    <% if (partial = current_bottom_nav_partial).present? %>
      <%= render "shared/nav/#{partial}" %>
    <% end %>

    <div id="ga-tracker" data-controller="ga"></div>
  </body>
</html>
