<%= form_with model: post, data: { turbo_frame: "_top" } do |f| %>
  <div class="w-full max-w-none">
    <div class="mb-4">
      <%= f.label :body, "今日のメモ", class: "block text-sm font-medium text-slate-700 mb-1" %>

      <%= f.text_area :body,
            class: "w-full border rounded-xl p-4 h-60 text-sm",
            placeholder: "いまの気持ちを書いてみよう…" %>
    </div>

    <% if mode == :modal %>
      <p class="mt-2 text-[11px] text-slate-500">
        ※ バディからのお返事に時間がかかることがあります
      </p>
    <% end %>

    <div class="mt-6 flex justify-end gap-3">
      <% if mode == :modal %>
        <button
          type="button"
          class="px-4 py-2 rounded-lg border border-slate-300 text-slate-600"
          data-action="click->post-modal#close"
        >
          やめる
        </button>

        <%= f.submit "投稿する",
              class: "bg-sky-500 text-white px-5 py-2 rounded-lg hover:bg-sky-600" %>
      <% else %>
        <%= link_to "やめる",
              root_path,
              class: "px-4 py-2 rounded-lg border border-slate-300 text-slate-600" %>

        <%= f.submit "更新する",
              class: "bg-sky-500 text-white px-5 py-2 rounded-lg hover:bg-sky-600" %>
      <% end %>
    </div>
  </div>
<% end %>
