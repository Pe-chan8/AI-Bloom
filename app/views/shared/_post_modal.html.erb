<div
  data-action="click->post-modal#backdrop"
  data-post-modal-target="modal"
  class="hidden fixed inset-0 z-50 bg-black/40"
>
  <div class="min-h-screen flex items-center justify-center p-4">
    <!-- ✅ 角括弧なし：tailwind生成漏れを避ける -->
    <div class="w-full max-w-5xl rounded-2xl bg-white shadow-xl overflow-hidden">
      <div class="flex items-center justify-between px-4 py-3 border-b">
        <p class="text-sm font-semibold text-slate-700">新規投稿</p>
        <button
          type="button"
          class="text-slate-500 hover:text-slate-700"
          data-action="click->post-modal#close"
          aria-label="close"
        >
          ✕
        </button>
      </div>

      <div class="p-4 max-h-[75vh] overflow-auto">
        <turbo-frame
          id="post_form_frame"
          src=""
          data-post-modal-target="frame"
        ></turbo-frame>
      </div>
    </div>
  </div>

  <div
    id="post-modal-close-signal"
    data-post-modal-target="closeSignal"
    class="hidden"
  ></div>
</div>
