<% points = local_assigns.fetch(:points) %>

<% width = 720; height = 220; padding = 28; left_pad = 80 %>
<% count_max = [points.map(&:count).max.to_i, 1].max %>

<% xs = points.each_with_index.map { |_, i|
     left_pad + (i.to_f * (width - left_pad - padding) / [points.size - 1, 1].max)
   } %>

<% # 折れ線（avg: 1..5 -> y） %>
<% ys = points.map do |p|
     if p.avg
       v = p.avg.clamp(1.0, 5.0)
       padding + ((5.0 - v) * (height - padding*2) / 4.0)
     end
   end %>

<% # 棒（count -> y/height） %>
<% bar_base_y = height - padding %>
<% bar_top_ys = points.map do |p|
     h = (p.count.to_f / count_max) * (height - padding*2)
     bar_base_y - h
   end %>

<% # 折れ線 path %>
<% path = +""; started = false %>
<% xs.zip(ys).each do |x, y| %>
  <% if y %>
    <% if started %>
      <% path << " L #{x} #{y}" %>
    <% else %>
      <% path << "M #{x} #{y}" %>
      <% started = true %>
    <% end %>
  <% else %>
    <% started = false %>
  <% end %>
<% end %>

<div class="border border-slate-400/60 bg-[#FBF6E3] p-4 mt-4">
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="font-semibold">気分の傾向（週次）と投稿数</p>
      <p class="text-sm text-slate-600 mt-1">
        “評価”ではなく、最近の記録から「波」を見える化しています。
      </p>

      <% filled_weeks = points.count { |p| p.avg.present? } %>
      <% if filled_weeks < 2 %>
        <p class="text-xs text-slate-500 mt-2">
          まだ記録が少ないため点が中心になります。記録が増えるほど流れ（線）が見えてきます 🌱
        </p>
      <% end %>
    </div>
  </div>

  <div class="bg-white/70 border border-slate-200 rounded-xl p-3 mt-3 overflow-x-auto">
    <div class="min-w-[720px]">
      <svg viewBox="0 0 <%= width %> <%= height %>" class="w-full h-56">
        <!-- ガイドライン（5段） -->
        <% (1..5).each do |level| %>
          <% y = padding + ((5 - level) * (height - padding*2) / 4.0) %>
          <line
            x1="<%= padding %>" y1="<%= y %>"
            x2="<%= width - padding %>" y2="<%= y %>"
            stroke="rgba(15,23,42,0.08)"
          />
        <% end %>

        <!-- 左の気分ラベル（Figma寄せ） -->
        <% labels = { 5 => "とてもいい", 4 => "いい", 3 => "普通", 2 => "悪い", 1 => "とても悪い" } %>
        <% labels.each do |level, text| %>
          <% y = padding + ((5 - level) * (height - padding*2) / 4.0) %>
          <text x="<%= padding - 10 %>" y="<%= y + 4 %>" text-anchor="end" font-size="11" fill="rgba(15,23,42,0.55)">
            <%= text %>
          </text>
        <% end %>

        <!-- 棒（投稿数） -->
        <% bar_w = 26 %>
        <% xs.each_with_index do |x, i| %>
          <% top_y = bar_top_ys[i] %>
          <% h = bar_base_y - top_y %>
          <rect
            x="<%= x - bar_w/2 %>" y="<%= top_y %>"
            width="<%= bar_w %>" height="<%= h %>"
            rx="6"
            fill="rgba(56,189,248,0.28)"
          />
          <text x="<%= x %>" y="<%= bar_base_y - 4 %>" text-anchor="middle" font-size="11" fill="rgba(15,23,42,0.55)">
            <%= points[i].count %>件
          </text>
        <% end %>

        <!-- 折れ線 -->
        <path
          d="<%= path %>"
          fill="none"
          stroke="rgba(15,23,42,0.72)"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />

        <!-- 点 -->
        <% xs.zip(ys).each do |x, y| %>
          <% next unless y %>
          <circle cx="<%= x %>" cy="<%= y %>" r="5" fill="rgba(245,158,11,0.9)" />
        <% end %>
      </svg>

      <!-- x軸ラベル（週） -->
      <div class="mt-2 grid" style="grid-template-columns: repeat(<%= points.size %>, minmax(0, 1fr));">
        <% points.each do |p| %>
          <div class="text-[11px] text-slate-600 text-center">
            <%= p.week_start.strftime("%m/%d") %>週
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
