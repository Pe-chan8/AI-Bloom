<% tabs = [
  ["全カテゴリー", "all"],
  ["仕事", "work"],
  ["恋愛", "love"],
  ["家庭", "family"],
  ["学習", "study"],
  ["その他", "other"],
] %>

<div class="mt-4">
  <div class="flex flex-wrap items-center gap-2">
    <% tabs.each do |label, key| %>
      <% active = (category == key) %>

      <%= link_to analysis_path(
            category: key,
            subcategory: subcategory,
            show_weakness_items: (params[:show_weakness_items].presence),
            show_weakness_tips:  (params[:show_weakness_tips].presence)
          ),
          class: [
            "inline-flex items-center gap-2 px-4 py-2 rounded-full border text-sm font-bold transition",
            "focus:outline-none focus:ring-2 focus:ring-amber-300",
            (active ? "bg-amber-200 border-amber-300 text-slate-900 shadow-sm" : "bg-white border-slate-300 text-slate-700 hover:bg-slate-50")
          ].join(" "),
          aria: { current: (active ? "page" : nil) } do %>

        <span><%= label %></span>

        <% if active %>
          <span class="text-[11px] font-extrabold px-2 py-0.5 rounded-full bg-white/70 border border-amber-300">
            選択中
          </span>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
