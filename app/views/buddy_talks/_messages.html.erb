<%= turbo_frame_tag "messages" do %>
  <% talk = local_assigns[:buddy_talk] || @buddy_talk %>

  <div id="messages_list"
       class="space-y-4"
       data-ai-polling-post-id="<%= talk&.id %>">
    <% messages.each do |message| %>
      <%= render "message", message: message, buddy: buddy %>
    <% end %>
  </div>
<% end %>
