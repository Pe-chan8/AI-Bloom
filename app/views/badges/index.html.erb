<% content_for :title, "あなたの頑張りの証 - AI-Bloom" %>

  <div class="flex justify-center">
    <div class="inline-flex items-center gap-2">
      <h1 class="text-3xl font-extrabold tracking-wide text-slate-900">
        あなたの頑張りの証
      </h1>
      <%= render "shared/help_tip",
        text: "バディとの会話や自己分析の結果に応じて\n獲得できるバッジの一覧です。\n集めてみてね！",
        position: "right" %>
    </div>
  </div>

  <div class="mt-10 bg-white rounded-2xl shadow-sm border border-amber-100 p-8">
    <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
      <% 8.times do %>
        <div class="aspect-square rounded-2xl border border-slate-200 bg-slate-100/70 flex items-center justify-center">
          <span class="text-slate-500 text-sm font-semibold">お待ちください</span>
        </div>
      <% end %>
    </div>

    <div class="mt-8 text-center text-sm text-slate-500">
      バッジ機能は準備中です。もう少しだけ待っててね 🌻
    </div>
  </div>
</div>
