<% content_for :title, "アカウント設定 - AI-Bloom" %>

<section class="px-4 py-10">
  <div class="mx-auto w-full max-w-4xl">
    <!-- タイトル帯 -->
    <div class="mx-auto w-fit rounded-xl bg-amber-50/60 px-10 py-3">
      <h1 class="text-3xl font-extrabold tracking-wide text-slate-900">
        アカウント設定
      </h1>
    </div>

    <p class="text-xm text-slate-500 text-center mt-2 mb-6">
      あなたのアカウントや通知設定を管理します。
    </p>

    <!-- 枠 -->
    <div class="mt-10 rounded-3xl border-2 border-slate-900/80 bg-white/90 backdrop-blur-sm rounded-3xl border border-amber-100 shadow-sm p-8">
      <!-- 入力ブロック -->
      <div class="rounded-3xl border-2 border-slate-900/60 p-6">
        <div class="space-y-6">
          <div>
            <p class="text-sm font-semibold text-slate-800">ニックネーム変更</p>
            <div class="mt-2 h-12 w-full rounded-2xl border-2 border-slate-900/50 bg-slate-100/30 flex items-center justify-center">
              <span class="text-slate-700 font-semibold">お待ちください</span>
            </div>
          </div>

          <div>
            <p class="text-sm font-semibold text-slate-800">メールアドレス変更</p>
            <div class="mt-2 h-12 w-full rounded-2xl border-2 border-slate-900/50 bg-slate-100/30 flex items-center justify-center">
              <span class="text-slate-700 font-semibold">お待ちください</span>
            </div>
          </div>

          <div class="pt-2 text-center text-sm text-slate-700 font-semibold">
            パスワードをお忘れの方（準備中）
          </div>
        </div>
      </div>

      <!-- トグル系 -->
      <div class="mt-8 space-y-4">
        <div class="flex items-center justify-between rounded-2xl border-2 border-slate-900/60 px-6 py-4">
          <p class="text-lg font-extrabold text-slate-900">通知設定</p>
          <div class="flex gap-3">
            <span class="rounded-xl bg-slate-300/70 px-6 py-2 font-extrabold text-slate-900">ON</span>
            <span class="rounded-xl bg-slate-300/70 px-6 py-2 font-extrabold text-slate-900">OFF</span>
          </div>
        </div>

        <div class="flex items-center justify-between rounded-2xl border-2 border-slate-900/60 px-6 py-4">
          <p class="text-lg font-extrabold text-slate-900">UIモード設定</p>
          <div class="flex gap-3">
            <span class="rounded-xl bg-slate-300/70 px-6 py-2 font-extrabold text-slate-900">Light</span>
            <span class="rounded-xl bg-slate-300/70 px-6 py-2 font-extrabold text-slate-900">Dark</span>
          </div>
        </div>
      </div>

      <!-- 保存ボタン -->
      <div class="mt-8 flex justify-end">
        <button type="button" class="rounded-full bg-slate-300/70 px-8 py-3 font-extrabold text-slate-900 border border-slate-900/30">
          変更を保存（準備中）
        </button>
      </div>
    </div>
  </div>
</section>
