<% content_for :title, "投稿一覧 - AI-bloom" %>

<div class="flex justify-center">
  <div class="inline-flex items-center gap-2">
    <h1 class="text-3xl font-extrabold tracking-wide text-slate-900 mb-4">
      投稿一覧
    </h1>
    <%= render "shared/help_tip",
      text: "これまでの記録をまとめて見られます。\n検索や編集もできます。",
      position: "right" %>
  </div>
</div>

<div class="max-w-3xl mx-auto pt-6 space-y-6 px-6 pb-10">
  <% label_map = {"work"=>"仕事","love"=>"恋愛","family"=>"家庭","study"=>"学習","other"=>"その他"} %>

  <!-- 検索 + 並び替え + 絞り込み（1枚に統合） -->
  <div class="bg-white rounded-2xl shadow-sm border border-amber-100 px-5 py-4 space-y-4">
    <%= form_with url: posts_path, method: :get, local: true, class: "space-y-4" do %>
      <div class="flex items-center gap-2 text-slate-700">
        <span class="text-lg">🔎</span>
        <div class="font-extrabold">検索・絞り込み</div>
      </div>

      <!-- キーワード -->
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
        <div class="flex-1">
          <%= text_field_tag "q[body_cont]",
                params.dig(:q, :body_cont),
                placeholder: "例）仕事 / 勉強 / うれしかったこと…",
                class: "w-full rounded-xl border border-slate-200 px-4 py-2 text-sm
                        focus:ring-2 focus:ring-sky-300 focus:outline-none" %>
        </div>

        <div class="flex gap-2 sm:shrink-0">
          <%= submit_tag "適用",
                class: "px-5 py-2 rounded-xl text-sm font-bold bg-slate-200 text-slate-800 hover:bg-slate-300" %>

          <%= link_to "解除",
                posts_path,
                class: "px-5 py-2 rounded-xl text-sm font-bold bg-slate-200 text-slate-800 hover:bg-slate-300 text-center" %>
        </div>
      </div>

      <!-- 並び替え -->
      <div class="flex items-center gap-3 text-sm">
        <div class="font-semibold text-slate-700">日付で並び替え</div>
        <%= select_tag :sort,
              options_for_select(
                [["新しい順", "date_desc"], ["古い順", "date_asc"]],
                params[:sort].presence || "date_desc"
              ),
              class: "rounded-xl border border-slate-200 px-3 py-2 text-sm bg-white" %>
      </div>

      <!-- 絞り込み -->
      <div class="rounded-2xl bg-amber-50/30 border border-amber-100 p-4">
        <div class="font-extrabold text-slate-800 mb-3">絞り込み</div>

        <% mood_options =
            [["すべて", "all"]] +
            Post.moods.keys.map do |k|
              label =
                begin
                  tmp = Post.new(mood: k)
                  tmp.respond_to?(:mood_label) ? tmp.mood_label : k
                rescue
                  k
                end
              [label, k]
            end
        %>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
          <div class="flex items-center gap-3">
            <div class="w-16 font-semibold text-slate-700">日付</div>
            <%= date_field_tag :date, params[:date],
                  class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm bg-white" %>
          </div>

          <div class="flex items-center gap-3">
            <div class="w-16 font-semibold text-slate-700">★</div>
            <%= select_tag :favorite,
                  options_for_select(
                    [["すべて", "all"], ["お気に入りのみ", "yes"], ["お気に入り以外", "no"]],
                    params[:favorite].presence || "all"
                  ),
                  class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm bg-white" %>
          </div>

          <div class="flex items-center gap-3">
            <div class="w-16 font-semibold text-slate-700">気分</div>
            <%= select_tag :mood,
                  options_for_select(mood_options, params[:mood].presence || "all"),
                  class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm bg-white" %>
          </div>

          <div class="flex items-center gap-3">
            <div class="w-16 font-semibold text-slate-700">カテゴリ</div>
            <%= select_tag :category,
                  options_for_select(
                    [["すべて", "all"], ["仕事", "work"], ["恋愛", "love"], ["家庭", "family"], ["学習", "study"], ["その他", "other"]],
                    params[:category].presence || "all"
                  ),
                  class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm bg-white" %>
          </div>
        </div>
      </div>

      <% if params[:q].present? %>
        <p class="text-xs text-slate-500">
          「<%= params.dig(:q, :body_cont) %>」で検索中
        </p>
      <% end %>
    <% end %>
  </div>

  <% if @posts.any? %>
    <div class="space-y-4">
      <% @posts.each do |post| %>
        <div class="bg-white rounded-2xl shadow-sm border border-amber-100 px-5 py-4">
          <div class="flex items-center justify-between text-xs text-slate-500 mb-2">
            <span>
              <% datetime = post.posted_at || post.created_at %>
              <%= l datetime, format: :short %>
            </span>
          </div>

          <div class="text-base font-semibold text-slate-800">
            <%= post.title.presence || "（無題）" %>
          </div>

          <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
            <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-amber-50 text-amber-800 border border-amber-100 font-semibold">
              気分：<%= post.respond_to?(:mood_label) ? post.mood_label : (post.mood_i18n rescue post.mood) %>
            </span>

            <% if post.category.present? %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-white text-slate-700 border border-slate-200 font-semibold">
                <%= label_map[post.category] || post.category %>
              </span>
            <% end %>

            <% if post.subcategory.present? %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-white text-slate-700 border border-slate-200 font-semibold">
                <%= post.subcategory %>
              </span>
            <% end %>
          </div>

          <div class="mt-4 flex items-center gap-2">
            <%= link_to "▶︎ 会話を開く",
                  buddy_talk_topic_path(post),
                  data: { turbo: false },
                  class: "shrink-0 text-sm font-semibold text-amber-800 hover:underline hover:bg-amber-50 px-1 py-1 rounded-md" %>

            <div class="ml-auto flex items-center gap-2 justify-end">
              <% if user_signed_in? %>
                <% favorited = @favorite_post_ids.include?(post.id) %>

                <% if favorited %>
                  <%= button_to "★ お気に入り",
                    post_favorite_path(post),
                    method: :delete,
                    form: { class: "inline-block" },
                    class: "inline-flex items-center justify-center rounded-full px-4 py-2 text-xs font-semibold
                            border border-amber-200 bg-amber-50 text-slate-700 hover:bg-amber-50/70" %>
                <% else %>
                  <%= button_to "☆ お気に入り",
                    post_favorite_path(post),
                    method: :post,
                    form: { class: "inline-block" },
                    class: "inline-flex items-center justify-center rounded-full px-4 py-2 text-xs font-semibold
                            border border-slate-200 bg-white text-slate-700 hover:bg-slate-50" %>
                <% end %>
              <% end %>

              <%= link_to "編集",
                    edit_post_path(post),
                    data: { turbo_frame: "_top" },
                    class: "inline-flex items-center justify-center rounded-full px-4 py-2 text-xs font-semibold
                            border border-slate-200 bg-white text-slate-700 hover:bg-slate-50" %>

              <%= button_to "削除",
                    post_path(post),
                    method: :delete,
                    form: { class: "inline-block", data: { turbo_confirm: "本当にこの投稿を削除しますか？" } },
                    class: "inline-flex items-center justify-center rounded-full px-4 py-2 text-xs font-semibold
                            border border-rose-300 text-rose-600 hover:bg-rose-50" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <% if @posts.total_pages > 1 %>
      <div class="mt-6 flex justify-center">
        <div class="flex items-center gap-2">
          <% if @posts.prev_page %>
            <%= link_to "◀", url_for(request.query_parameters.merge(page: @posts.prev_page)),
                  class: "px-3 py-1.5 rounded-full bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 text-sm" %>
          <% else %>
            <span class="px-3 py-1.5 rounded-full bg-slate-100 text-slate-400 text-sm cursor-default">◀</span>
          <% end %>

          <% @posts.total_pages.times do |i| %>
            <% page_num = i + 1 %>
            <% if page_num == @posts.current_page %>
              <span class="px-3 py-1.5 rounded-full bg-amber-100 text-slate-800 border border-amber-200 text-sm font-semibold">
                <%= page_num %>
              </span>
            <% else %>
              <%= link_to page_num, url_for(request.query_parameters.merge(page: page_num)),
                    class: "px-3 py-1.5 rounded-full bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 text-sm" %>
            <% end %>
          <% end %>

          <% if @posts.next_page %>
            <%= link_to "▶", url_for(request.query_parameters.merge(page: @posts.next_page)),
                  class: "px-3 py-1.5 rounded-full bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 text-sm" %>
          <% else %>
            <span class="px-3 py-1.5 rounded-full bg-slate-100 text-slate-400 text-sm cursor-default">▶</span>
          <% end %>
        </div>
      </div>
    <% end %>

  <% else %>
    <div class="bg-white rounded-2xl shadow-sm border border-amber-100 px-4 py-6 text-center text-sm text-slate-500">
      まだ投稿がありません。<br>
      <strong>「バディと話す」</strong>から、今日の気持ちを残してみましょう 🌻
    </div>
  <% end %>
</div>
