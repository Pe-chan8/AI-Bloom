<% title = local_assigns[:title] %>
<% tips  = Array(local_assigns[:tips]) %>

<% category = local_assigns[:category] || "all" %>
<% subcategory = local_assigns[:subcategory] %>

<% maskable = local_assigns[:maskable] %>
<% show_tips = local_assigns[:show_weakness_tips] %>

<div class="border border-slate-800 bg-white p-4 rounded-2xl shadow-sm h-full">
  <div class="flex items-center justify-between gap-3 mb-3">
    <p class="font-bold"><%= title %></p>

    <% if maskable %>
      <% if show_tips %>
        <%= link_to "▶︎ 閉じる",
              analysis_path(
                category: category,
                subcategory: subcategory,
                show_weakness_items: (params[:show_weakness_items].presence)
              ),
              class: "text-sm font-bold text-slate-700 hover:text-slate-900 underline" %>
      <% else %>
        <%= link_to "▶︎ 見る",
              analysis_path(
                category: category,
                subcategory: subcategory,
                show_weakness_tips: "1",
                show_weakness_items: (params[:show_weakness_items].presence)
              ),
              class: "text-sm font-bold text-slate-700 hover:text-slate-900 underline" %>
      <% end %>
    <% end %>
  </div>

  <% if maskable && !show_tips %>
    <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-sm text-slate-700">
      <p class="font-bold">＊もう一歩踏み出すための提案です</p>
      <p class="text-xs text-slate-500 mt-1">（必要なときだけ開けば大丈夫です）</p>
    </div>
  <% else %>
    <% if tips.empty? %>
      <p class="text-sm text-slate-600">まだ提案がありません。</p>
    <% else %>
      <ul class="list-disc pl-5 text-sm text-slate-700 space-y-2">
        <% tips.each do |t| %>
          <li><%= t %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>
