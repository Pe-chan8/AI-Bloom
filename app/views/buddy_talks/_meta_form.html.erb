<section class="bg-white rounded-3xl border border-amber-100 shadow-sm p-6 space-y-5">
  <h2 class="text-lg font-bold text-center text-slate-800">会話のはじまり</h2>

  <%= form_with model: post, url: start_buddy_talk_path, data: { turbo: false }, class: "space-y-4" do |f| %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div>
        <%= f.label :posted_at, "日付", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= f.datetime_local_field :posted_at,
              value: (post.posted_at || Time.zone.now).strftime("%Y-%m-%dT%H:%M"),
              class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" %>
      </div>

      <div>
        <%= f.label :title, "タイトル", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= f.text_field :title,
              placeholder: "例）面談で褒められた",
              class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" %>
      </div>
    </div>

    <div>
      <p class="block text-sm font-semibold text-slate-700 mb-2">気分</p>
      <div class="flex flex-wrap gap-2">
        <label class="inline-flex items-center gap-2 rounded-full border px-3 py-2 bg-white text-sm">
          <%= f.radio_button :mood, :positive %>
          <span>いい日</span>
        </label>
        <label class="inline-flex items-center gap-2 rounded-full border px-3 py-2 bg-white text-sm">
          <%= f.radio_button :mood, :neutral %>
          <span>普通</span>
        </label>
        <label class="inline-flex items-center gap-2 rounded-full border px-3 py-2 bg-white text-sm">
          <%= f.radio_button :mood, :negative %>
          <span>悪い日</span>
        </label>
      </div>
    </div>

    <div class="mt-2">
      <p class="font-semibold text-slate-800">タグ（複数選択OK）</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <% selected = (post.tags_text || "").split(",").map(&:strip) %>
        <% Post::TAG_OPTIONS.each do |tag| %>
          <label class="inline-flex items-center gap-2 rounded-full border px-4 py-2 bg-white shadow-sm cursor-pointer">
            <%= check_box_tag "post[tag_list][]", tag, selected.include?(tag),
                  class: "rounded text-sky-500 focus:ring-sky-300" %>
            <span class="text-sm text-slate-700"><%= tag %></span>
          </label>
        <% end %>
      </div>
      <p class="mt-2 text-xs text-slate-500">※今は仮（将来はタグマスタ化も可能）</p>
    </div>

    <div>
      <%= f.label :body, "本文（ひとことでもOK）", class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= f.text_area :body,
            rows: 6,
            placeholder: "今日あったことを自由に書いてね",
            class: "w-full rounded-2xl border border-slate-200 px-3 py-3 text-sm" %>
    </div>

    <div class="pt-2">
      <%= f.submit "会話をはじめる",
        class: "w-full rounded-2xl px-6 py-4 font-semibold
                bg-amber-100 text-slate-800 border border-amber-200
                shadow-sm hover:bg-amber-200 active:bg-amber-200 transition" %>
    </div>

    <% if post.errors.any? %>
      <div class="mt-4 rounded-2xl border border-rose-200 bg-rose-50 p-4">
        <p class="text-sm font-semibold text-rose-700">入力に不備があります</p>
        <ul class="mt-2 list-disc pl-5 text-sm text-rose-700">
          <% post.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>
</section>
