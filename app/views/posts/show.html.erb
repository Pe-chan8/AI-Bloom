<% content_for :title, "投稿詳細 - AI-Bloom" %>

<div class="max-w-2xl mx-auto px-4 py-4 space-y-6">

  <!-- タイトル -->
  <h1 class="text-2xl font-bold text-slate-800">投稿詳細</h1>

  <!-- 投稿本文 -->
  <div class="bg-[#FFF7EA] rounded-2xl px-4 py-3 space-y-2 shadow-sm border border-amber-100">
    <p class="text-sm text-slate-700 whitespace-pre-wrap"><%= @post.body %></p>
    <p class="text-xs text-slate-400 text-right"><%= @post.created_at.strftime("%Y-%m-%d %H:%M") %></p>
  </div>

  <!-- AIバディからのメッセージ -->
  <% if @rate_limited %>
    <section class="mt-4 text-xs text-slate-500 text-center">
      <p>今日はAIバディへのお願いが上限に達しました。</p>
      <p>またあした、ゆっくり一緒にふりかえりましょうね。</p>
    </section>

  <% elsif @ai_error == :too_many_requests %>
    <section class="mt-4 text-xs text-slate-500 text-center space-y-2">
      <p>AIの応答が混み合っているか、利用上限に達している可能性があります。</p>
      <p>少し時間をおいて、ページを開き直してみてください🙏</p>
    </section>

  <% elsif @ai_message.present? %>
    <%= render "shared/ai_buddy_message", ai_message: @ai_message %>
  <% end %>

  <!-- 戻る・編集リンク -->
  <div class="flex justify-between text-sm mt-6">
    <%= link_to "← 閉じる",
            posts_path,
            class: "text-xs font-semibold text-slate-600 hover:text-slate-800" %>
    <%= link_to "編集する", edit_post_path(@post), class: "text-amber-600 hover:underline" %>
  </div>

</div>
