<% content_for :title, "バッジ詳細 - AI-Bloom" %>

<section class="px-4 py-10">
  <div class="mx-auto w-full max-w-4xl">
    <div class="mx-auto w-fit rounded-xl bg-amber-50/60 px-8 py-3">
      <h1 class="text-3xl font-extrabold tracking-wide text-slate-900">
        バッジ詳細
      </h1>
    </div>

    <div class="mt-10">
      <div class="mx-auto max-w-2xl rounded-3xl border-2 border-slate-900/80 bg-slate-200/60 p-10 flex items-center justify-center aspect-[16/9]">
        <span class="text-3xl font-extrabold text-slate-900">画像</span>
      </div>

      <div class="mt-8 flex items-center justify-center">
        <div class="w-full max-w-2xl rounded-2xl bg-slate-300/70 px-6 py-5 text-center text-3xl font-extrabold text-slate-900 border-2 border-slate-900/70">
          バッジ詳細
        </div>
      </div>

      <div class="mt-6 flex justify-end">
        <button type="button" class="rounded-full bg-slate-300/70 px-8 py-3 text-sm font-semibold text-slate-900 border border-slate-900/30">
          結果を共有
        </button>
      </div>

      <p class="mt-6 text-center text-sm text-slate-600">
        詳細表示は準備中です（「お待ちください」表示に差し替えてもOK）
      </p>
    </div>
  </div>
</section>

