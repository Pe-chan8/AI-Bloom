<% text = local_assigns[:text].to_s %>

<% this_week_posts_count = local_assigns[:this_week_posts_count] %>
<% this_week_mood_avg     = local_assigns[:this_week_mood_avg] %>

<% last_week_posts_count = local_assigns[:last_week_posts_count] %>
<% last_week_mood_avg     = local_assigns[:last_week_mood_avg] %>

<div class="border border-slate-800 bg-white p-4 rounded-2xl shadow-sm h-full">
  <p class="font-semibold mb-2">直近2週間のあなたの歩み</p>

  <div class="text-sm text-slate-700 space-y-2">
    <div>
      今週：
      投稿数 <span class="font-semibold"><%= this_week_posts_count.to_i %>件</span> /
      気分平均
      <% if this_week_mood_avg.present? %>
        <span class="font-semibold"><%= this_week_mood_avg %></span>
      <% else %>
        <span class="text-slate-500">―</span>
      <% end %>
    </div>

    <div>
      先週：
      投稿数 <span class="font-semibold"><%= last_week_posts_count.to_i %>件</span> /
      気分平均
      <% if last_week_mood_avg.present? %>
        <span class="font-semibold"><%= last_week_mood_avg %></span>
      <% else %>
        <span class="text-slate-500">―</span>
      <% end %>
    </div>

    <div class="pt-1">
      ひとこと：
      <% if text.present? %>
        <span><%= text %></span>
      <% else %>
        <span class="text-slate-500">まずは、今日の気持ちをひとつだけでもOKです。</span>
      <% end %>
    </div>
  </div>
</div>
