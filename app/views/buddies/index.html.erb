<% content_for :title, "バディ選択 - AI-Bloom" %>

  <div class="flex justify-center">
    <div class="inline-flex items-center gap-2">
      <h1 class="text-3xl font-extrabold tracking-wide text-slate-900">
        バディ選択
      </h1>
      <%= render "shared/help_tip",
        text: "あなたのバディを選んでください。\nバディはいつでも変更できます。",
        position: "right" %>
    </div>
  </div>

  <% buddy_image_paths = {
       "normal"        => "buddies/normal_buddy.png",
       "kansai_friend" => "buddies/kansai_friend_buddy.png",
       "analytical"    => "buddies/analytical_buddy.png",
       "amiable"       => "buddies/amiable_buddy.png",
       "driving"       => "buddies/driving_buddy.png",
       "expressive"    => "buddies/expressive_buddy.png"
     } %>

  <% special_buddies, type_buddies = @buddies.partition { |b| ["normal", "kansai_friend"].include?(b.code) } %>
  <% normal_buddy  = special_buddies.find { |b| b.code == "normal" } %>
  <% kansai_buddy  = special_buddies.find { |b| b.code == "kansai_friend" } %>

  <div class="pt-4">
    <p class="text-xs font-semibold text-slate-500 tracking-wide">ノーマルバディ</p>
  </div>

  <% if normal_buddy.present? %>
    <% is_current_normal = (current_buddy&.id == normal_buddy.id) %>

    <section class="bg-white rounded-3xl shadow-sm border
                    <%= is_current_normal ? 'border-amber-300 ring-2 ring-amber-100' : 'border-amber-100' %>
                    px-6 py-6">

      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">

        <div class="flex-1 space-y-2">
          <p class="text-lg font-semibold text-slate-800"><%= normal_buddy.display_name %></p>
          <p class="text-sm text-slate-700 leading-relaxed"><%= normal_buddy.description %></p>

          <% if normal_buddy.tone_hint.present? %>
            <p class="text-[11px] text-slate-500 bg-amber-50 rounded-2xl px-3 py-2 inline-block border border-amber-100">
              <span class="font-semibold">話し方のイメージ：</span>
              <%= normal_buddy.tone_hint %>
            </p>
          <% end %>
        </div>

        <div class="mt-4 md:mt-0 flex flex-col items-center md:items-end gap-3 md:w-56 md:self-stretch">
          <div class="w-24 h-24 rounded-full bg-amber-50 flex items-center justify-center overflow-hidden border border-amber-100">
            <%= image_tag buddy_image_for(normal_buddy),
                  alt: normal_buddy.display_name,
                  class: "w-full h-full object-contain" %>
          </div>

          <% if is_current_normal %>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-xs
                        bg-emerald-100 text-emerald-700 border border-emerald-200">
              ✓ このバディを使用中
            </span>
          <% else %>
            <%= button_to "このバディにする",
              select_buddy_path(normal_buddy),
              method: :post,
              onclick: "return confirm('#{normal_buddy.display_name} にバディを変更しますか？')",
              class: "px-4 py-2 rounded-full text-xs font-semibold
                      bg-sky-500 text-white hover:bg-sky-600 transition" %>
          <% end %>
        </div>

      </div>
    </section>
  <% end %>

  <div class="pt-4">
    <p class="text-xs font-semibold text-slate-500 tracking-wide">タイプ別バディ</p>
  </div>

  <section class="grid gap-6 md:grid-cols-2">
    <% type_buddies.each do |buddy| %>
      <% is_current = (current_buddy&.id == buddy.id) %>

      <article class="bg-white rounded-3xl shadow-sm border px-6 py-5 flex flex-col gap-3
                      <%= is_current ? 'border-amber-300 ring-2 ring-amber-100' : 'border-amber-100' %>">

        <div class="flex items-center justify-between">
          <p class="text-lg font-semibold text-slate-800"><%= buddy.display_name %></p>

          <div class="w-16 h-16 rounded-full bg-amber-50 flex items-center justify-center overflow-hidden border border-amber-100">
            <% if buddy_image_paths[buddy.code].present? %>
              <%= image_tag buddy_image_paths[buddy.code],
                    alt: "#{buddy.display_name}のアイコン",
                    class: "w-full h-full object-contain" %>
            <% else %>
              <span class="text-3xl">🐧</span>
            <% end %>
          </div>
        </div>

        <p class="text-sm text-slate-700 leading-relaxed"><%= buddy.description %></p>

        <% if buddy.tone_hint.present? %>
          <p class="text-[11px] text-slate-500 bg-amber-50 rounded-2xl px-3 py-2 border border-amber-100">
            <span class="font-semibold">話し方のイメージ：</span>
            <%= buddy.tone_hint %>
          </p>
        <% end %>

        <div class="mt-1 flex justify-end">
          <% if is_current %>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-xs
                        bg-emerald-100 text-emerald-700 border border-emerald-200">
              ✓ このバディを使用中
            </span>
          <% else %>
            <%= button_to "このバディにする",
              select_buddy_path(buddy),
              method: :post,
              onclick: "return confirm('#{buddy.display_name} にバディを変更しますか？')",
              class: "px-4 py-2 rounded-full text-xs font-semibold
                      bg-sky-500 text-white hover:bg-sky-600 transition" %>
          <% end %>
        </div>
      </article>
    <% end %>
  </section>

  <div class="pt-4">
    <p class="text-xs font-semibold text-slate-500 tracking-wide">特別バディ</p>
  </div>

  <% if kansai_buddy.present? %>
    <% is_current_kansai = (current_buddy&.id == kansai_buddy.id) %>

    <section class="bg-white rounded-3xl shadow-sm border
                    <%= is_current_kansai ? 'border-amber-300 ring-2 ring-amber-100' : 'border-amber-100' %>
                    px-6 py-6">

      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="flex-1 space-y-2">
          <p class="text-lg font-semibold text-slate-800"><%= kansai_buddy.display_name %></p>
          <p class="text-sm text-slate-700 leading-relaxed"><%= kansai_buddy.description %></p>

          <% if kansai_buddy.tone_hint.present? %>
            <p class="text-[11px] text-slate-500 bg-amber-50 rounded-2xl px-3 py-2 inline-block border border-amber-100">
              <span class="font-semibold">話し方のイメージ：</span>
              <%= kansai_buddy.tone_hint %>
            </p>
          <% end %>
        </div>

        <div class="mt-4 md:mt-0 flex flex-col items-center md:items-end gap-3 md:w-56 md:self-stretch">
          <div class="w-24 h-24 rounded-full bg-amber-50 flex items-center justify-center overflow-hidden border border-amber-100">
            <% if buddy_image_paths[kansai_buddy.code].present? %>
              <%= image_tag buddy_image_paths[kansai_buddy.code],
                    alt: "#{kansai_buddy.display_name}のアイコン",
                    class: "w-full h-full object-contain" %>
            <% else %>
              <span class="text-4xl">🐧</span>
            <% end %>
          </div>

          <% if is_current_kansai %>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-xs
                        bg-emerald-100 text-emerald-700 border border-emerald-200">
              ✓ このバディを使用中
            </span>
          <% else %>
            <%= button_to "このバディにする",
              select_buddy_path(kansai_buddy),
              method: :post,
              onclick: "return confirm('#{kansai_buddy.display_name} にバディを変更しますか？')",
              class: "px-4 py-2 rounded-full text-xs font-semibold
                      bg-sky-500 text-white hover:bg-sky-600 transition" %>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <p class="text-[11px] text-slate-500">
    ※ バディを選んでいない場合は、<br>
      自動的に「ノーマルバディ」があなたを見守ります。
  </p>
