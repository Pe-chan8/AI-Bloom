<% items ||= [] %>
<% tips  ||= [] %>
<% points ||= [] %>

<% items = Array(local_assigns[:items]) %>

<div class="border border-slate-800 bg-white p-4 rounded-2xl shadow-sm h-full">
  <p class="font-semibold mb-3">強み傾向</p>

  <p class="text-sm text-slate-600 mb-4">
    最近の会話から、あなたらしさが表れやすいポイントをまとめました。
  </p>

  <% if items.empty? %>
    <div class="bg-white/70 border border-slate-200 rounded-xl p-4 text-sm text-slate-700">
      まだデータがありません（会話や投稿が増えると表示されます）
    </div>
  <% else %>
    <ol class="space-y-3">
      <% items.each_with_index do |item, idx| %>
        <li class="bg-white/80 border border-slate-200 rounded-xl p-3">
          <div class="flex items-start gap-2">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-amber-100 text-slate-800 text-xs font-bold">
              <%= idx + 1 %>
            </span>
            <p class="font-semibold text-slate-900">
              <%= item[:label] %>：<span class="font-semibold text-slate-700"><%= item[:short] %></span>
            </p>
          </div>
        </li>
      <% end %>
    </ol>
  <% end %>
</div>
