<div class="fixed left-0 right-0 bottom-[var(--bottom-nav-h)] z-40" style="--composer-h: 220px;">
  <div class="px-4 xs:px-6 pb-0">
    <div class="bg-white/95 backdrop-blur border border-amber-100 shadow-lg rounded-3xl p-4 lg:p-5">
      <%= form_with url: reply_buddy_talk_path(buddy_talk),
            method: :post,
            data: { turbo: true },
            class: "space-y-3" do %>

        <div class="flex gap-3 items-stretch">
          <%= text_area_tag :message, "",
                rows: 2,
                placeholder: "いまの気持ちや、思ったことを自由に書いてみてください",
                class: "flex-1 resize-none rounded-2xl border border-amber-100 bg-white/70 px-4 py-2 text-xs
                        focus:ring-2 focus:ring-amber-200 focus:outline-none" %>

          <%= submit_tag "送信",
                data: { disable_with: "送信中…" },
                class: "w-24 xs:w-28 rounded-2xl font-semibold
                        bg-sky-100 text-sky-800 border border-sky-200
                        hover:bg-sky-200 active:bg-sky-200 transition" %>
        </div>
      <% end %>

      <div class="mt-3 flex gap-2">
        <%= button_to "一緒に振り返る",
              deep_dive_buddy_talk_path(buddy_talk),
              method: :post,
              form: { data: { turbo: true, turbo_submits_with: "生成中…" } },
              class: "flex-1 rounded-2xl px-3 py-1.5 text-xs font-semibold whitespace-nowrap
                      bg-white border border-amber-200 text-amber-900 hover:bg-amber-50 transition" %>

        <%= button_to "やさしくまとめる",
              praise_summary_buddy_talk_path(buddy_talk),
              method: :post,
              form: { data: { turbo: true, turbo_submits_with: "まとめ中…" } },
              class: "flex-1 rounded-2xl px-3 py-1.5 text-xs font-semibold whitespace-nowrap
                      bg-amber-100 border border-amber-200 text-slate-800 hover:bg-amber-200 transition" %>
      </div>
    </div>
  </div>
</div>
