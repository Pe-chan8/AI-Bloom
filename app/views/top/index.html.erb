<% content_for :title, "マイルーム - AI-Bloom" %>

<div class="max-w-5xl mx-auto px-6 py-4 space-y-8">
  <header class="space-y-1">
    <p class="text-xs text-sky-700 mb-4">
      日々の小さな頑張りをやさしく抱きしめる<br>
      自己理解アプリ AI-Bloom
    </p>
  </header>

  <div class="flex justify-center">
    <div class="inline-flex items-center gap-2">
      <h1 class="text-3xl font-extrabold tracking-wide text-slate-900">
        ホーム
      </h1>
      <%= render "shared/help_tip",
        text: "ここはあなたのマイルームです。\nバディとゆっくり過ごしてね。",
        position: "right" %>
    </div>
  </div>

  <% buddy = current_buddy %>

  <% buddy_image_paths = {
       "normal" => "buddies/normal_buddy.png",
       "analytical" => "buddies/analytical_buddy.png",
       "amiable" => "buddies/amiable_buddy.png",
       "driving" => "buddies/driving_buddy.png",
       "expressive" => "buddies/expressive_buddy.png",
       "kansai_friend" => "buddies/kansai_friend_buddy.png"
     } %>

  <section class="bg-white/90 backdrop-blur-sm rounded-3xl border border-amber-100 shadow-sm px-6 py-6 space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-base font-semibold text-slate-800">あなたのバディ</h2>
    </div>

    <div class="flex flex-col items-center gap-3 mt-2">
      <div class="w-28 h-28 rounded-full bg-gradient-to-br from-sky-50 to-amber-100 flex items-center justify-center overflow-hidden border border-amber-100">
        <% if buddy && buddy_image_paths[buddy.code].present? %>
          <%= image_tag buddy_image_paths[buddy.code],
                alt: "#{buddy.display_name} のアイコン",
                class: "w-full h-full object-contain" %>
        <% else %>
          <span class="text-4xl">🐧</span>
        <% end %>
      </div>

      <div class="text-center space-y-1">
        <p class="text-lg font-semibold text-slate-800">
          <%= buddy&.name || "ノーマルバディ" %>
        </p>
      </div>
    </div>

    <p class="mt-3 text-[11px] text-slate-500">
      ※ バディは、診断結果やあなたの選択に合わせて変えられます。<br>
      あとから「バディ選択」画面で、いつでも変更できます。
    </p>

    <%= link_to "バディを変更する",
          buddies_path,
          class: "text-xs text-sky-600 hover:underline" %>

    <div class="bg-white/90 rounded-3xl shadow-sm border border-amber-100 px-6 py-6 flex flex-col gap-4">
      <div class="flex items-center gap-2">
        <p class="text-sm font-semibold text-slate-700">
          <%= buddy&.display_name || "バディ" %>からのメッセージ
        </p>
      </div>

      <div class="rounded-2xl border border-amber-100 bg-amber-50/50 px-4 py-4 text-sm leading-relaxed text-slate-700">
        <p class="text-sm text-slate-700 leading-relaxed">
          <%= @top_message %>
        </p>
      </div>
    </div>
  </section>
</div>
