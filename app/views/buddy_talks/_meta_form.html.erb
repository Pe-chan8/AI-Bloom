<section class="bg-white rounded-3xl border border-amber-100 shadow-sm p-6 space-y-5">
  <h2 class="text-lg font-bold text-center text-slate-800">今日のお話のはじまり</h2>

  <%= form_with model: post, url: start_buddy_talk_path, data: { turbo: false }, class: "space-y-4" do |f| %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-1">
      <div>
        <%= f.label :posted_at, "日付", class: "block text-xs font-semibold text-slate-700 mb-1" %>
        <%= f.datetime_local_field :posted_at,
              value: (post.posted_at || Time.zone.now).strftime("%Y-%m-%dT%H:%M"),
              class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-xs" %>
      </div>

      <div>
        <%= f.label :title, "タイトル", class: "block text-xs font-semibold text-slate-700 mb-1" %>
        <%= f.text_field :title,
              placeholder: "例）面談で褒められた",
              class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-xs" %>
      </div>
    </div>

    <div>
      <p class="block text-xs font-semibold text-slate-700 mb-2">気分</p>

      <% mood_options = [
        [:very_positive, "とてもいい"],
        [:positive,      "いい"],
        [:neutral,       "普通"],
        [:negative,      "悪い"],
        [:very_negative, "とても悪い"],
      ] %>

      <div class="flex flex-wrap gap-1">
        <% mood_options.each do |key, label| %>
          <label class="inline-flex items-center gap-1 rounded-full border px-3 py-2 bg-white text-sm">
            <%= f.radio_button :mood, key %>
            <span><%= label %></span>
          </label>
        <% end %>
      </div>
    </div>

    <!-- タグ→カテゴリー/サブカテゴリー -->
    <div class="mt-2 space-y-3">

      <% category_options = [
        ["仕事", "work"],
        ["恋愛", "love"],
        ["家庭", "family"],
        ["学習", "study"],
        ["その他", "other"],
      ] %>

      <!-- 常に縦並び -->
      <div class="space-y-3">
        <div>
          <%= f.label :category, "カテゴリー", class: "font-semibold text-slate-800" %>
          <%= f.select :category,
                options_for_select(category_options, post.category),
                { include_blank: "選択してください" },
                class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-xs bg-white" %>
          <p class="text-xs text-slate-500 mt-1">※分析タブと連動します</p>
        </div>

        <div>
          <%= f.label :subcategory, "サブカテゴリー（任意）", class: "font-semibold text-slate-800" %>
          <%= f.text_field :subcategory,
                placeholder: "例）面談 / 体調 / 進捗 / 不安 など",
                class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-xs" %>
          <p class="text-xs text-slate-500 mt-1">※自由入力。あとで絞り込みに使えます</p>
        </div>
      </div>
    </div>
    <!-- ここまで -->

    <div>
      <%= f.label :body, "本文（ひとことでもOK）", class: "block text-xs font-semibold text-slate-700 mb-1" %>
      <%= f.text_area :body,
            rows: 6,
            placeholder: "今日あったこと、感じたことを自由に書いてみてね。ひとことでも大丈夫です。",
            class: "w-full rounded-2xl border border-slate-200 px-3 py-3 text-xs" %>
    </div>

    <div class="pt-2">
      <%= f.submit "バディと話しはじめる",
            data: { disable_with: "開始中…" },
            class: "w-full rounded-2xl px-4 py-3 text-xs font-semibold
                    bg-amber-100 border border-amber-200 text-slate-800 hover:bg-amber-200 transition" %>
    </div>

    <% if post.errors.any? %>
      <div class="mt-4 rounded-2xl border border-rose-200 bg-rose-50 p-4">
        <p class="text-xs font-semibold text-rose-700">入力に不備があります</p>
        <ul class="mt-2 list-disc pl-5 text-xs text-rose-700">
          <% post.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>
</section>
