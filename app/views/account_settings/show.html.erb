<% content_for :title, "アカウント設定 - AI-Bloom" %>

<section class="px-4 py-10">
  <div class="mx-auto w-full max-w-4xl">
    <div class="flex justify-center">
      <div class="inline-flex items-center gap-2">
        <h1 class="text-3xl font-extrabold tracking-wide text-slate-900">
          アカウント設定
        </h1>
        <%= render "shared/help_tip",
          text: "あなたのアカウントや通知設定を管理します。",
          position: "right" %>
      </div>
    </div>

    <div class="mt-10 bg-white rounded-2xl shadow-sm border border-amber-100 p-8 space-y-8">

      <div class="rounded-3xl border-2 border-amber-300 p-6 space-y-8">

        <!-- ニックネーム変更 -->
        <div>
          <p class="text-sm font-semibold text-slate-800">ニックネーム変更</p>

          <%= form_with model: @user,
              url: update_nickname_account_setting_path,
              method: :patch,
              local: true do |f| %>

            <div class="mt-2 space-y-4">
              <%= f.text_field :nickname,
                maxlength: 30,
                class: "h-12 w-full rounded-2xl border-2 border-slate-900/50 bg-white px-4 font-semibold text-slate-900" %>

              <div class="flex justify-end">
                <button type="submit"
                  style="background:#f59e0b;color:#fff;padding:10px 18px;border-radius:9999px;font-weight:800;">
                  保存する
                </button>
              </div>
            </div>
          <% end %>
        </div>

        <!-- メールアドレス変更 -->
        <div>
          <p class="text-sm font-semibold text-slate-800">メールアドレス変更</p>

          <%= form_with model: @user,
              url: update_email_account_setting_path,
              method: :patch,
              data: { turbo: false } do |f| %>

            <div class="mt-2 space-y-4">
              <%= f.email_field :email,
                value: @user.unconfirmed_email.presence || @user.email,
                placeholder: "example@example.com",
                class: "h-12 w-full rounded-2xl border-2 border-slate-900/50 bg-white px-4 font-semibold text-slate-900" %>

              <%= f.password_field :current_password,
                placeholder: "現在のパスワード",
                class: "h-12 w-full rounded-2xl border-2 border-slate-900/50 bg-white px-4 font-semibold text-slate-900" %>

              <p class="text-xs text-slate-500 font-semibold">
                変更後のメール宛に確認メールを送信します。リンクをクリックすると変更が完了します。
              </p>

              <div class="flex justify-end">
                <button type="submit"
                  style="background:#f59e0b;color:#fff;padding:10px 18px;border-radius:9999px;font-weight:800;">
                  保存する
                </button>
              </div>
            </div>
          <% end %>
        </div>

      </div>

      <!-- トグル系 -->
      <div class="space-y-4">
        <div class="flex items-center justify-between rounded-2xl border-2 border-amber-300 px-6 py-4">
          <p class="text-lg font-extrabold text-slate-900">通知設定（準備中）</p>
          <div class="flex gap-3">
            <span class="rounded-xl bg-slate-300/70 px-6 py-2 font-extrabold text-slate-900">ON</span>
            <span class="rounded-xl bg-slate-300/70 px-6 py-2 font-extrabold text-slate-900">OFF</span>
          </div>
        </div>

        <div class="flex items-center justify-between rounded-2xl border-2 border-amber-300 px-6 py-4">
          <p class="text-lg font-extrabold text-slate-900">UIモード設定（準備中）</p>
          <div class="flex gap-3">
            <span class="rounded-xl bg-slate-300/70 px-6 py-2 font-extrabold text-slate-900">Light</span>
            <span class="rounded-xl bg-slate-300/70 px-6 py-2 font-extrabold text-slate-900">Dark</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
