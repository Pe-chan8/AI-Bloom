<% content_for :title, "パスワード再設定 - AI-bloom" %>

<div class="max-w-md mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold text-slate-900 mb-2">パスワードを再設定する</h1>
  <p class="text-slate-600 mb-6">
    登録したメールアドレスに、再設定用リンクをお送りします。
  </p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-slate-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "mt-2 w-full rounded-xl border border-slate-200 px-3 py-2 focus:outline-none focus:ring" %>
    </div>

    <div class="pt-2">
      <%= f.submit "再設定リンクを送る",
            class: "w-full rounded-xl bg-slate-900 text-white py-2 font-semibold hover:opacity-90" %>
    </div>
  <% end %>

  <div class="mt-6 text-center">
    <%= link_to "ログインに戻る", new_user_session_path, class: "text-slate-700 underline" %>
  </div>
</div>
