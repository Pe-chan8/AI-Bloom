<% content_for :title, "バディと話す - AI-bloom" %>

  <div class="flex justify-center">
    <div class="inline-flex items-center gap-2">
      <h1 class="text-3xl font-extrabold tracking-wide text-slate-900">
        バディと話す
      </h1>
      <%= render "shared/help_tip",
        text: "バディとの会話を通じて、あなたの気持ちや考えを整理しましょう。",
        position: "right" %>
    </div>
  </div>

  <%= render "meta_readonly", buddy_talk: @post %>

  <div class="pt-4">
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800 border border-amber-100">
        会話ログ
      </span>
      <div class="h-px flex-1 bg-amber-100"></div>
    </div>
  </div>

  <%= render "chat", buddy_talk: @post, messages: @messages %>
</div>

<%= render "composer", buddy_talk: @post %>
